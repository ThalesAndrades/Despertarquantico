# ============================================================
# Despertar Espiral — Environment configuration
# ------------------------------------------------------------
# Copy this file to `.env` at the project root on the server.
# NEVER commit the real .env — it is git-ignored.
# Deploy via git: create the .env manually once on Hostinger,
# then `git pull` normally; configs read from here at runtime.
# ============================================================

# --- Application ---
APP_NAME="Despertar Espiral"
APP_URL=https://despertarespiral.com
APP_ENV=production
APP_DEBUG=false
HEALTHCHECK_TOKEN=

# --- Database (Hostinger MySQL) ---
DB_HOST=localhost
DB_NAME=u525832347_Mulherespiral
DB_USER=u525832347_Mulherespiral
DB_PASS=
DB_CHARSET=utf8mb4

# --- Initial admin user (only used once on first migrate) ---
# If ADMIN_INIT_PASSWORD is empty, no admin is auto-created — you must
# create one via install.php or by seeding the database manually.
ADMIN_INIT_EMAIL=sunyan@despertarespiral.com
ADMIN_INIT_PASSWORD=
ADMIN_INIT_NAME="Sunyan Nunes"

# --- Mail (transactional fallback: reset password, order receipt) ---
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SECURE=ssl
MAIL_USER=noreply@despertarespiral.com
MAIL_PASS=
MAIL_FROM_EMAIL=noreply@despertarespiral.com
MAIL_FROM_NAME="Despertar Espiral"

# --- Woovi (OpenPix) payment gateway — PIX ---
# AppID gerado em https://app.woovi.com (API / Plugins). Exige 2FA habilitado.
# Vai CRU no header Authorization, sem prefixo "Bearer".
WOOVI_APP_ID=
# Timeout das chamadas a API, em segundos.
WOOVI_TIMEOUT=20
# Opcional. A chave publica da Woovi (que valida o header x-webhook-signature)
# ja vem embutida em config/woovi.php; so preencha aqui se a Woovi rotacionar
# a chave e voce precisar corrigir sem fazer deploy de codigo.
WOOVI_WEBHOOK_PUBLIC_KEY=

# --- Sequenzy lifecycle automation ---
# If your Sequenzy workspace provides a webhook URL, set it here (optional).
SEQUENZY_WEBHOOK_URL=
SEQUENZY_ENABLED=true
SEQUENZY_TIMEOUT=3
# API key is used to trigger events (Sequences) and send Transactional emails.
SEQUENZY_API_URL=https://api.sequenzy.com/api/v1
SEQUENZY_API_KEY=
SEQUENZY_TRANSACTIONAL_ENABLED=false
# template | direct
SEQUENZY_TRANSACTIONAL_MODE=template
SEQUENZY_TRANSACTIONAL_FROM="Despertar Espiral <noreply@despertarespiral.com>"
SEQUENZY_TRANSACTIONAL_REPLY_TO="Suporte <noreply@despertarespiral.com>"

# --- High Ticket (mentoria premium) ---
# Optional booking link (Calendly/YouCanBookMe). Used in Sequenzy emails.
HIGH_TICKET_BOOKING_URL=

# --- Google Login (OAuth) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://despertarespiral.com/auth/google/callback
